local function save_file()
  local ok, err = pcall(vim.cmd, "update")
  if not ok then
    vim.notify(tostring(err), vim.log.levels.ERROR, { title = "Salvataggio" })
    return
  end
  vim.notify("File salvato", vim.log.levels.INFO, { title = "Salvataggio" })
end

